# ==============================================================================
# Cloud File Storage System — Environment Configuration
# ==============================================================================
# Copy this file to .env and populate the values for your environment.
# Never commit .env with real secrets to version control.
# ==============================================================================

# ─── Database ─────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_strong_password
MYSQL_DATABASE=cloud_storage
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/cloud_storage?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change_me_strong_password

# ─── MinIO Object Storage ─────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key_at_least_8_chars
MINIO_BUCKET=cloud-files

# ─── Redis Cache ──────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=                 # Uncomment if Redis auth is enabled

# ─── RabbitMQ Messaging ───────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ─── Spring Boot Application ──────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
# JWT_SECRET must be at least 256 bits (32+ random characters).
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_256_BIT_SECRET_KEY

# ─── Frontend ─────────────────────────────────────────────────────────────────
# This is the URL the React frontend uses to call the backend REST API.
# In Docker Compose, the Nginx reverse proxy handles this automatically.
# For local dev without Docker: set this to http://localhost:8080
VITE_API_URL=http://localhost:8080

# ─── Ports ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=5173
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MYSQL_PORT=3306
REDIS_PORT_EXPOSE=6379
RABBITMQ_PORT_EXPOSE=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ─── Spring Boot Logging ──────────────────────────────────────────────────────
# Levels: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_APP=INFO
LOG_LEVEL_ROOT=WARN
